# Test image for every platform: the distribution's minimal image with Python for Ansible and
# sudo, so the tests use become the same way a real run does. On GitHub's runners sudo's PAM
# account check fails in the UBI images, so the test images skip it (Defaults !pam_acct_mgmt).
FROM {{ item.image }}

{% if 'ubi' in item.image %}
RUN dnf -y install sudo{{ ' python3.12' if 'ubi8' in item.image else '' }} \
    && dnf clean all \
    && echo 'Defaults !pam_acct_mgmt' > /etc/sudoers.d/molecule \
    && chmod 0440 /etc/sudoers.d/molecule
{% elif 'debian' in item.image or 'ubuntu' in item.image %}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 sudo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
{% elif 'suse' in item.image %}
RUN zypper --non-interactive install --no-recommends {{ 'python311' if ':15' in item.image else 'python3' }} sudo \
    && zypper clean --all
{% endif %}
